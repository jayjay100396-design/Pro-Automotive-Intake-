{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
    ]
  },
  "ailogic": {
    "templates": "prompts"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    },
    {
      "source": "functions-calendar",
      "codebase": "calendar",
      "predeploy": [
        "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    },
    {
      "source": "functions-alerts",
      "codebase": "alerts",
      "predeploy": [
        "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    },
    {
      "source": "functions-parts",
      "codebase": "parts",
      "predeploy": [
        "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "predeploy": [
      "bash \"$PROJECT_DIR/scripts/deploy-guard.sh\""
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/package.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "hosting": {
      "port": 5000
    }
  }
}
